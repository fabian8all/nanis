APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DEMO_PASSWORD=
DEMO_COORDINATOR_EMAIL=coordinacion@example.test
DEMO_SUPERVISOR_EMAIL=supervisor1@example.test
DEMO_USER_EMAIL_DOMAIN=example.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

SAML2_ENABLED=false
SAML_SIMULATOR=true
SAML_SIMULATOR_EMAIL=alumno@example.test
SAML_SIMULATOR_NAME="Alumno de prueba"
SAML_SIMULATOR_FIRSTNAME="Nombre de prueba"
SAML_SIMULATOR_LASTNAME="Apellido de prueba"
SAML2_EMAIL_ATTRIBUTE=uCorreo
SAML2_NAME_ATTRIBUTE=uNombre
SAML2_SP_ENTITY_ID=
SAML2_IDP_ENTITY_ID=
SAML2_IDP_SSO_URL=
SAML2_IDP_X509_CERT=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
