{
  "project": "nanis",
  "providers": [
    "codex",
    "copilot"
  ],
  "estado_dev": {
    "path": ".ai/state/estado-dev.md",
    "max_index_lines": 80,
    "topics_dir": ".ai/state/topics",
    "max_topic_lines": 300,
    "max_topic_tokens": 1500
  },
  "roles": {
    "dir": ".ai/roles",
